# Copy to .env and fill in. NEVER commit .env to Git.

# --- MetaTrader 5 (Exness / Deriv) ---
MT5_LOGIN=12345678
MT5_PASSWORD=change-me
MT5_SERVER=Exness-MT5Trial          # exact server name shown in your MT5 login screen
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Crypto exchange (create keys with READ + TRADE only, NO withdrawal, IP-restricted) ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=              # only for exchanges that need it (OKX etc.)

# --- Gemini ---
GEMINI_API_KEY=

# --- Control API (generate: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
API_TOKEN=

# --- Firebase Cloud Messaging (service-account JSON path) ---
FCM_CREDENTIALS_FILE=secrets/firebase.json